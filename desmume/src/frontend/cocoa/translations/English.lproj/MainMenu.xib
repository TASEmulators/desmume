					<object class="IBToolTipAttribute" key="NS.object.0">
						<string key="name">ToolTip</string>
						<reference key="object" ref="972490397"/>
						<string key="toolTip">Provides smooth sound at all emulation speeds, but with some added latency. High latency. Low CPU usage.</string>
					</object>
				</object>
				<string key="2436.IBPluginDependency">com.apple.InterfaceBuilder.CocoaPlugin</string>
