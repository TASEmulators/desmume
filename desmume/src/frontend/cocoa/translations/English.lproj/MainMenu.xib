					<object class="IBToolTipAttribute" key="NS.object.0">
						<string key="name">ToolTip</string>
						<reference key="object" ref="15321861"/>
						<string key="toolTip">Makes more features available to the emulated hardware, but may affect ROM compatibility. May incur CPU usage, depending on which BIOS options are used.</string>
					</object>
				</object>
				<string key="4033.IBPluginDependency">com.apple.InterfaceBuilder.CocoaPlugin</string>
				<string key="4034.IBPluginDependency">com.apple.InterfaceBuilder.CocoaPlugin</string>
