						<string key="name">ToolTip</string>
						<reference key="object" ref="211612809"/>
						<string key="toolTip">Has the lowest latency of all the sound synchronization methods, but is not compatible with the advanced SPU emulation engine. Neglible latency. Negligible CPU usage.</string>
					</object>
				</object>
				<string key="3723.IBPluginDependency">com.apple.InterfaceBuilder.CocoaPlugin</string>
