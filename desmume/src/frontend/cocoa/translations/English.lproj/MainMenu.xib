						<string key="name">ToolTip</string>
						<reference key="object" ref="379003821"/>
						<string key="toolTip">Performs no sound interpolation. This method produces the most accurate sound compared to the real hardware. All sound detail is preserved, but some sounds may sound harsh due to the presence of high-end harmonics. No CPU usage.</string>
					</object>
				</object>
				<string key="2427.IBPluginDependency">com.apple.InterfaceBuilder.CocoaPlugin</string>
