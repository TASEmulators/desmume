#ifdef __OBJC__
	#define OBJ_C
#endif

#define HOST_DARWIN
#define DESMUME_COCOA
#define ENABLE_OPENGL_STANDARD
#define HAVE_LIBZ
#ifdef ENABLE_LUA_COCOA
#define HAVE_LUA
#define LUA_USE_POSIX
#define LUA_USE_DLOPEN
// Cocoa has no LuaJIT import library: the entry points are resolved from a
// dlopen()ed libluajit-5.1.dylib at runtime, the way Windows delay-loads
// lua51.dll.  See LuaJITApi.cpp / LuaJITApiSymbols.h.
#define DESMUME_LUA_DYNAMIC
#endif

#define FT2_BUILD_LIBRARY
#define DARWIN_NO_CARBON

#define GL_SILENCE_DEPRECATION

#if defined(__i386__) || defined(__x86_64__) || defined(__aarch64__)
	#define HAVE_JIT
#endif

#if defined(__ppc__) || defined(__ppc64__)
	#define MSB_FIRST 1
#endif

#if defined(__APPLE__)
	#include <AvailabilityMacros.h>
	
	#if !defined(METAL_DISABLE_FOR_BUILD_TARGET) && defined(MAC_OS_X_VERSION_10_11) && (MAC_OS_X_VERSION_MAX_ALLOWED >= MAC_OS_X_VERSION_10_11)
		#define ENABLE_APPLE_METAL
		// Metal OSD: the AGG-free shape/glyph recorder lives in
		// userinterface/MacMetalOSDDraw.cpp and is driven by the core frame loop.
		#define DESMUME_COCOA_METAL_OSD
	#endif
#endif

#define PORT_VERSION	"Cocoa"
#define PORT_VERSION_OS_X_APP
