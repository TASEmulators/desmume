RESRCS = resources.rc

# Media Foundation recording.  mf_build.h turns it on by itself for MSVC; the
# MSYS2 clang64 and ucrt64 toolchains carry <mfapi.h>, <mfreadwrite.h> and the
# matching import libraries as well, so a build there can opt in with
#
#     make MF=1 CROSS=x86_64-w64-mingw32-
#
# The default i686 target this file is written for has no Media Foundation
# headers, which is why this is a switch and not a test.
ifeq ($(MF),1)
  CPPFLAGS += -DDESMUME_ENABLE_MF=1
  LIBS += -lmfplat -lmfreadwrite -lmfuuid
  SRCS += mflite.cpp mfvideowriter.cpp videoencoders.cpp recording_settings.cpp
endif

RESOBJS = $(RESRCS:.rc=.o)
OBJS=$(SRCS:.cpp=.o)
COBJS=$(CSRCS:.c=.o)

# AsmJit sources and the ARM JIT front-end get C++20; everything else in the
# emulator stays at gnu++14.
../../arm_jit.o: ../../arm_jit.cpp
	$(CXX) $(CPPFLAGS) $(JIT_CXXFLAGS) -c $< -o $@

../../../3rdparty/asmjit/%.o: ../../../3rdparty/asmjit/%.cpp
	$(CXX) $(CPPFLAGS) $(JIT_CXXFLAGS) -c $< -o $@

all: desmume.exe

../../version.cpp: ../../scmrev.h

../../scmrev.h:
	SRCROOT=. sh ../cocoa/git-scmrev.sh

../../lua/liblua.a: $(wildcard ../../lua/*.c)
	( cd ../../lua ; rm -f liblua.a *.o ; make -j CC=$(CC) AR="$(AR) rcu" RANLIB=$(RANLIB) MYCFLAGS="-O3" liblua.a ; )

resources.o: resources.rc
	$(WINDRES) $< $@

desmume.exe: $(OBJS) $(COBJS) $(RESOBJS) ../../lua/liblua.a
	$(CXX) $^ $(LDFLAGS) -o $@ $(LIBS)

clean:
	rm -f $(OBJS) $(COBJS) $(RESOBJS) desmume.exe ../../lua/*.o ../../lua/liblua.a ../../scmrev.h

lightclean:
	rm -f $(OBJS) desmume.exe

.PHONY: all clean lightclean
