    <submenu>
      <attribute name='label' translatable='yes'>_Emulation</attribute>
      <section>
        <item>
          <attribute name='label' translatable='yes'>_Run / Pause</attribute>
          <attribute name='action'>app.run</attribute>
          <attribute name='accel'>Pause</attribute>
        </item>
        <item>
          <attribute name='label' translatable='yes'>Frame _advance</attribute>
          <attribute name='action'>app.frame-advance</attribute>
          <attribute name='accel'>&lt;Control&gt;n</attribute>
        </item>
        <item>
          <attribute name='label' translatable='yes'>Fast _forward</attribute>
