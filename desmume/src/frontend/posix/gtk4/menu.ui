              <attribute name='action'>app.gpufilter</attribute>
              <attribute name='target' type='s'>'12'</attribute>
            </item>
          </section>
        </submenu>
      </section>
      <section>
        <item>
          <attribute name='label' translatable='yes'>Show _menu bar</attribute>
          <attribute name='action'>app.view-menu</attribute>
        </item>
