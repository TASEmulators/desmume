          <attribute name='accel'>Tab</attribute>
        </item>
        <item>
          <attribute name='label' translatable='yes'>Re_set</attribute>
          <attribute name='action'>app.reset</attribute>
        </item>
      </section>
      <section>
        <item>
          <attribute name='label' translatable='yes'>_Limit framerate</attribute>
          <attribute name='action'>app.fps-limiter</attribute>
        </item>
        <item>
          <attribute name='label' translatable='yes'>_Auto frameskip</attribute>
          <attribute name='action'>app.auto-frameskip</attribute>
        </item>
        <submenu>
          <attribute name='label' translatable='yes'>Frames_kip</attribute>
